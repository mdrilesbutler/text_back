{#- Account (mockup d1): who is signed in, the remembered devices from the session table with
    "Remember this device" in the same card, then Sign out and Sign out everywhere. Sign out everywhere
    confirms in place (a disclosure, never a modal); without JavaScript the first POST opens it. -#}
{% extends "client/base.html.j2" %}
{% from "client/_macros.html.j2" import icon, csrf_input, button, node %}
{% block content %}
<div class=page-head><h1>Account</h1></div>
<ol class=spine>
  {% call node("icon", "user-round") %}
    <div class=node__head><h2>Signed in as {{ signed_in_as|nw }}</h2><p class=node__blurb>To change the mobile that signs you in, open <a class=tap href=/client/phone>Phone</a>.</p></div>
  {% endcall %}
  {% call node("icon", "monitor-smartphone") %}
    <div class=node__head><h2 id=devices-title>This device</h2></div>
    <form method=post action=/client/account/remember class=card id=account-form aria-labelledby=devices-title data-track-changes>
      {{ csrf_input(csrf) }}
      <ul class=devices>
        <li class="device device--current" data-device=this>{{ icon("monitor-smartphone") }}<span class=tnum>{{ ("This device · signed in " ~ this_device.signed_in|when(tz, now, relative=False) ~ " · stays signed in until " ~ (this_device.until|when(tz, now, relative=False) if this_device.until_today else this_device.until|day(tz)))|nw }}</span></li>
      </ul>
      <label class=switch-row for=remember><span class=switch-row__text>Remember this device for 30 days</span><input type=checkbox role=switch class=switch id=remember name=remember value=1{% if remember %} checked{% endif %} aria-describedby=remember-status data-note-on="{{ remember_on }}" data-note-off="{{ remember_off }}"></label>
      <p class=field-help id=remember-status data-remember-status>{{ remember_status }}</p>
      {#- Resting Save: visibly off (aria-disabled, so it still posts without JS); the first edit turns it on. #}
      <div class="actions actions--rest"><button type=submit class="btn btn--primary" form=account-form aria-disabled=true data-loading="Saving…" data-rest-save>Save</button><span class=savebar__rest data-rest-status>No unsaved changes</span></div>
    </form>
    {% for heading, rows in (("Remembered devices", remembered_devices), ("Other signed-in devices", unremembered_devices)) if rows %}
    <div class=devices-group>
      <h3 class=devices-group__title>{{ heading }}</h3>
      <ul class=devices>{% for d in rows %}<li class=device data-device=other>{{ icon("monitor-smartphone") }}<span class=tnum>{{ ("Another device · last used " ~ d.last_used|when(tz, now, relative=False))|nw }}{% if d.example %} <span class=extag>Example</span>{% endif %}</span></li>{% endfor %}</ul>
    </div>
    {% endfor %}
    {% if not other_devices %}<p class=field-help>Only this device is signed in.</p>{% endif %}
  {% endcall %}
  {% call node("icon", "arrow-left") %}
    <div class=signout>
      <form method=post action=/client/logout>{{ csrf_input(csrf) }}{{ button("Sign out", variant="secondary") }}</form>
      <details class=confirm-inline{% if confirm_everywhere %} open{% endif %}>
        <summary class="btn btn--secondary confirm-inline__trigger">Sign out everywhere</summary>
        <form method=post action=/client/account/signout-everywhere class=confirm-inline__panel id=everywhere aria-labelledby=everywhere-q data-confirm-everywhere>
          {{ csrf_input(csrf) }}<input type=hidden name=confirm value=1>
          <p class=confirm-inline__q id=everywhere-q>Sign out of every device? You'll need a new code on each one.</p>
          <div class=actions>
            <a class="btn btn--secondary" href=/client/account>Stay signed in</a>
            {{ button("Yes, sign out everywhere", variant="danger") }}
          </div>
        </form>
      </details>
    </div>
  {% endcall %}
</ol>
{% endblock %}
