{#- Phone (portal_phone.page_context): business name, numbers (the texting number is read-only text, never a
    field), the HELP number, the carrier with its forwarding codes, and the five forwarding checks. -#}
{% extends "client/base.html.j2" %}
{% from "client/_macros.html.j2" import icon, csrf_input, field_error, button, notice as notice_box %}
{% from "client/_form_errors.html.j2" import field_summary %}
{% block page_class %}phone{% endblock %}
{% macro described(key) -%}aria-describedby="{{ key }}-help{{ (' ' ~ key ~ '-error') if errors.get(key) else '' }}"{% if errors.get(key) %} aria-invalid=true{% endif %}{%- endmacro %}
{% macro err(key) -%}{% if errors.get(key) %}{{ field_error(key ~ "-error", errors[key]) }}{% endif %}{%- endmacro %}
{% block content %}
<header class=page-head>
  <h1>Phone</h1>
  <p class=lead>Your business name, the numbers TextBack uses, and call forwarding.</p>
</header>
{% if summary %}{{ field_summary(summary) }}{% endif %}
{% if page_error %}{{ notice_box("danger", page_error) }}{% endif %}
{% if rename_offer %}
<form method=post action=/client/phone/rename-texts class="card card--offer" data-rename-offer>
  {{ csrf_input(csrf) }}
  <p class=notice__text>Saved. Business name is now “{{ rename_offer.new_name }}”. {{ rename_offer.text }}</p>
  <div class=actions>
    <button type=submit class="btn btn--primary" name=action value=update>{{ rename_offer.accept }}</button>
    <button type=submit class="btn btn--secondary" name=action value=leave>{{ rename_offer.decline }}</button>
  </div>
</form>
{% endif %}
<form method=post action=/client/phone class=page__body id=phone-form>
  {{ csrf_input(csrf) }}
  <section class="card card--form" aria-labelledby=business-title>
    <h2 class=card__title id=business-title>Business</h2>
    <div class=field>
      <label class=field__label for=business_name>Business name</label>
      <p class=field-help id=business_name-help>{{ hints.business_name }}</p>
      <input class=input id=business_name name=business_name required maxlength=60 autocomplete=organization autocorrect=off value="{{ display.business_name }}" {{ described("business_name") }}>
      {{ err("business_name") }}
      <div class="well field-preview">
        <p class="eyebrow eyebrow--muted">In the first text</p>
        <div class="sms sms--textback"><p class=sms__bubble data-name-preview data-template="{{ name_template }}">{{ name_preview }}</p></div>
      </div>
    </div>
  </section>
  <section class="card card--form" aria-labelledby=numbers-title>
    <h2 class=card__title id=numbers-title>Numbers</h2>
    <p class=card__sub>Your business number never changes. Customers keep calling it.</p>
    <div class=field>
      <label class=field__label for=business_line>Your business number</label>
      <p class=field-help id=business_line-help>{{ hints.business_line }}</p>
      <input class="input input--tel tnum" id=business_line name=business_line type=tel inputmode=tel autocomplete=off maxlength=24 value="{{ display.business_line }}" {{ described("business_line") }}>
      {{ err("business_line") }}
    </div>
    <div class=field data-texting-number>
      <p class=field__label>Texting number</p>
      {% if texting_number %}<p class="tnum nowrap">{{ texting_number }}</p>{% endif %}
      <p class=field-help>{{ texting_note }}</p>
    </div>
    <div class=field>
      <label class=field__label for=owner_mobile>Your mobile</label>
      <p class=field-help id=owner_mobile-help>{{ hints.owner_mobile }}</p>
      <input class="input input--tel tnum" id=owner_mobile name=owner_mobile type=tel inputmode=tel required maxlength=24 autocomplete=tel value="{{ display.owner_mobile }}" {{ described("owner_mobile") }}>
      {{ err("owner_mobile") }}
      <p class=field-help data-mobile-status>This is the number that signs you in.</p>
    </div>
    <div class=field>
      <label class=field__label for=business_contact>Number in the HELP reply <span class=tag>Optional</span></label>
      <p class=field-help id=business_contact-help>{{ hints.business_contact }}</p>
      <input class="input input--tel tnum" id=business_contact name=business_contact type=tel inputmode=tel autocomplete=off maxlength=24 value="{{ display.business_contact }}" {{ described("business_contact") }}>
      {{ err("business_contact") }}
    </div>
  </section>
  <section class="card card--form" aria-labelledby=forwarding-title>
    <h2 class=card__title id=forwarding-title>Call forwarding</h2>
    <p class=card__sub>{{ forwarding_intro }}</p>
    <p class="notice notice--warning" data-forward-all-warning>{{ forward_all_warning }}</p>
    <fieldset class=field id=carrier>
      <legend class=field__label>Your carrier</legend>
      <div class=pill-radios>
      {% for key, name in carriers %}<input class=vh-input type=radio name=carrier id=carrier-{{ key }} value={{ key }}{% if carrier == key %} checked{% endif %}><label class=pill-radio for=carrier-{{ key }}>{{ name }}</label>{% endfor %}
      </div>
      {{ err("carrier") }}
    </fieldset>
    <div class=codes data-codes>
      {% if codes.enable or codes.disable %}
      {% for heading, rows in (("Turn forwarding on", codes.enable), ("Turn it off", codes.disable)) %}{% if rows %}
      <h3 class=codes__heading>{{ heading }}</h3>
      <dl class=codes__list>{% for label, code in rows %}<div class=code-row><dt>{{ label }}</dt><dd><code class=tnum>{{ code }}</code><button type=button class="btn btn--ghost" data-copy="{{ code }}" hidden>Copy<span class=vh> {{ label }} code</span></button></dd></div>{% endfor %}</dl>
      {% endif %}{% endfor %}
      {% endif %}
      {% if codes.steps %}<p class=field-help>{{ codes.steps }}</p>{% endif %}
      {% if codes.note %}<p class=field-help>{{ codes.note }}</p>{% endif %}
      {% if codes.unverified %}<p class="notice notice--warning">{{ codes.unverified }}</p>{% endif %}
    </div>
  </section>
  <div class=actions>{{ button("Save", block="block-phone", loading="Saving…") }}</div>
</form>
<form method=post action=/client/phone/checks class=card id=checks aria-labelledby=checks-title data-checklist>
  {{ csrf_input(csrf) }}
  <h2 class=card__title id=checks-title>Is forwarding working?</h2>
  <p class=card__sub data-checks-progress>{% if checklist.all_done %}All 5 done. Forwarding works.{% else %}{{ checklist.done_count }} of 5 done{% endif %}</p>
  <ol class=checks>
  {% for s in checklist.steps %}
    <li class="check check--{{ s.state }}" data-check={{ s.n }}>
      <p class=check__label>{{ s.label }}</p>
      <p class=check__state>{{ s.state_word }}</p>
      <p class=check__evidence>{{ s.evidence }}</p>
      {% if s.manual %}<label class=check__tick for={{ s.name }}><input type=checkbox class=checkbox id={{ s.name }} name={{ s.name }} value=1{% if s.state == "you_checked" %} checked{% endif %}><span class=vh>{{ s.label }}</span></label>{% endif %}
      {% if s.code %}<p class=field-help>Keep it where you'll find it: <code class=tnum>{{ s.code }}</code>.</p>{% endif %}
    </li>
  {% endfor %}
  </ol>
  <p class=field-help>{{ evidence_note }}</p>
  {{ button("Save checks", variant="secondary", block="block-phone", loading="Saving…") }}
</form>
{% endblock %}
