{#- Signed-out layout (mockup d1): brand-only topbar, one narrow column (a card from 640), the two-step
    stepper, then the page. Renders no csrf, number, clock or per-request value. `step` is 1 or 2. -#}
{% extends "client/_document.html.j2" %}
{% from "client/_macros.html.j2" import icon %}
{% block body %}
<header class="topbar topbar--auth"><span class=brand>{{ icon("phone", "brand__icon") }}TextBack</span></header>
<main class="page auth" id=main tabindex=-1>
<div class=auth__card>
  <ol class=stepper>
    <li class="stepper__step stepper__step--{{ 'current' if step == 1 else 'done' }}"{% if step == 1 %} aria-current=step{% endif %}><span class=stepper__dot>{% if step == 1 %}1{% else %}{{ icon("check") }}{% endif %}</span><span class=stepper__label>{% if step != 1 %}<span class=vh>Done: </span>{% endif %}Sign in</span></li>
    <li class="stepper__step{{ ' stepper__step--current' if step == 2 else '' }}"{% if step == 2 %} aria-current=step{% endif %}><span class=stepper__dot>2</span><span class=stepper__label>Check your phone</span></li>
  </ol>
{% block content %}{% endblock %}
  <p class=auth__foot>TextBack by FluxWorks</p>
</div>
</main>
{% endblock %}
