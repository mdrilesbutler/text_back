{#- notice_offer (Phone): the rename offer that follows a new business name, inside the same notice.
    One notice inside the role=status slot: no role of its own, no timer. The close button is shown by
    portal.js (without JavaScript it could do nothing, so it stays hidden). notice_kind defaults to success. -#}
{% from "client/_macros.html.j2" import icon %}
{% set kind = notice_kind|default("success") %}
<div class="notice notice--{{ kind }} toast" data-notice>{{ icon({"success": "circle-check", "info": "info", "warning": "triangle-alert"}[kind], "notice__icon") }}<div class=notice__body>{% if notice %}<p class=notice__text>{{ notice }}</p>{% endif %}
{%- if notice_offer is defined and notice_offer %}<p class=notice__text data-rename-offer>{{ notice_offer.text }}</p><form method=post action=/client/phone/rename-texts class=actions><input type=hidden name=csrf value='{{ csrf }}'><button type=submit class="btn btn--secondary" name=action value=update>{{ notice_offer.accept }}</button><button type=submit class="btn btn--ghost" name=action value=leave>{{ notice_offer.decline }}</button></form>{% endif %}</div><button type=button class="icon-btn toast__action" data-notice-dismiss hidden>{{ icon("x") }}<span class=vh>Dismiss</span></button></div>
