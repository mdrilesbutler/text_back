{#- notice_offer (Phone): the rename offer that follows a new business name, inside the same notice.
    One notice inside the role=status slot: no role of its own, no timer. Its close button sits beside the slot
    (dismiss_button, outside the live region) and is shown by portal.js. notice_kind defaults to success. -#}
{% from "client/_macros.html.j2" import icon %}
{% set kind = notice_kind|default("success") %}
<div class="notice notice--{{ kind }} toast" data-notice>{{ icon({"success": "circle-check", "info": "info", "warning": "triangle-alert"}[kind], "notice__icon") }}<div class=notice__body>{% if notice %}<p class=notice__text>{{ notice }}</p>{% endif %}
{%- if notice_offer is defined and notice_offer %}<p class=notice__text data-rename-offer>{{ notice_offer.text }}</p><form method=post action=/client/phone/rename-texts class="actions notice__actions"><input type=hidden name=csrf value='{{ csrf }}'><button type=submit class="btn btn--secondary" name=action value=update>{{ notice_offer.accept }}</button><button type=submit class="btn btn--secondary" name=action value=leave>{{ notice_offer.decline }}</button></form>{% endif %}</div></div>
