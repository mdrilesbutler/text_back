{#- Byte-identical for an unknown number and a wrong code. Never render any part of a phone number here. -#}
{% extends "client/auth.html.j2" %}
{% from "client/_macros.html.j2" import otp, button %}
{% block content %}
<header class=auth__head>
  <p class="eyebrow eyebrow--accent">{{ business_name }}</p>
  <h1>Check your phone</h1>
  <p class=lead id=code-help>Enter the 6-digit code we just texted. It expires in ten minutes.</p>
</header>
<form method=post action=/client/verify class=auth__form>
  <div class=field>
    <label class=field__label for=code>Sign-in code</label>
    {{ otp(help_id="code-help", error=error) }}
  </div>
  {{ button("Sign in", size="lg", block="block", loading="Signing in…") }}
</form>
<a class=auth__link href=/client/login>Didn't get it? Send a new code</a>
{% endblock %}
