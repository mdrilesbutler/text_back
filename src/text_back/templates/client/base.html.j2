{#- Signed-in shell (candidate C). Header: TextBack, then the business name as the Account menu trigger
    (wraps to two lines, never cut short). Nav: five tabs, a bottom bar on phones and a sticky sidebar on
    desktop. The in-flow #notice slot sits between the header and the page's h1; every save notice renders
    there (never a floating toast) and an error never does. -#}
{% extends "client/_document.html.j2" %}
{% from "client/_macros.html.j2" import icon, csrf_input %}
{% set nav_icons = {"home": "store", "messages": "message-square-text", "schedule": "clock", "calendar": "calendar-days", "phone": "phone"} %}
{% block body %}
<div class=shell>
  <header class=topbar>
    <a class=brand href=/client/home>{{ icon("message-square-text", "brand__icon") }}<span>TextBack</span></a>
    <details class=menu data-menu>
      <summary class=menu__trigger><span class=brand-name>{{ business_name }}</span><span class=vh> Account</span>{{ icon("chevron-down", "menu__chev") }}</summary>
      <div class=menu__panel>
        <p class="menu__meta tnum">Signed in with <span class=nowrap>{{ signed_in_with }}</span></p>
        <a class=menu__item href=/client/account>{{ icon("user-round") }}Account</a>
        <form method=post action=/client/logout>{{ csrf_input(csrf) }}<button type=submit class=menu__item>{{ icon("log-out") }}Sign out</button></form>
      </div>
    </details>
  </header>
  <nav class=nav aria-label=Settings>
  {% for id, label in nav %}
    <a class=nav__item href=/client/{{ id }}{% if nav_active == id %} aria-current=page{% endif %}><span class=nav__icon>{{ icon(nav_icons[id]) }}</span><span class=nav__label>{{ label }}</span></a>
  {% endfor %}
    <a class="nav__item nav__item--desktop" href=/client/account{% if nav_active == "account" %} aria-current=page{% endif %}><span class=nav__icon>{{ icon("user-round") }}</span><span class=nav__label>Account</span></a>
    <p class=nav__foot>TextBack by FluxWorks</p>
  </nav>
  <main id=main class="page page--{% block page_class %}{% endblock %}" tabindex=-1>
    <div class=notice-slot id=notice role=status>{% if notice %}<p class=notice-slot__text>{{ notice }}</p><button type=button class="icon-btn notice-slot__dismiss" data-notice-dismiss hidden>{{ icon("x") }}<span class=vh>Dismiss</span></button>{% endif %}</div>
    {% block content %}{% endblock %}
  </main>
</div>
{% endblock %}
{% block data %}{% if tb_data %}<script type=application/json id=tb-data>{{ tb_data|tojson }}</script>{% endif %}{% endblock %}
