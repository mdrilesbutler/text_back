{#- Calendar (mockup d1 round 3): the connection on the spine (state glyph + word), then the free-times
    check. Connected: "Bookings go here: <name>. Connected as <account>.", "Use a different calendar"
    opens the picker in place (a disclosure, no JavaScript needed), Reconnect is a link-styled post.
    Not connected: Home's words, why connecting matters, then Connect (with what Google will ask), Text
    FluxWorks support, or the sentence naming who sets it up. No state is a dead end. -#}
{% extends "client/base.html.j2" %}
{% from "client/_macros.html.j2" import icon, csrf_input, field_error, button, node, state_pill %}
{% set ok = card.connected %}
{% set kind = card.node %}
{% block content %}
<div class=page-head>
  <h1>Calendar</h1>
  <p class=lead>The assistant offers only times that are free on this calendar, and adds every booking to it before the customer gets a confirmation.</p>
</div>
{% if page_error %}<div class="notice notice--danger" role=alert>{{ icon("circle-alert", "notice__icon") }}<div class=notice__body><p class=notice__text>{{ page_error }}</p></div></div>{% endif %}
<ol class=spine>
  {% call node(kind, attrs="id=connection") %}
    <div class=node__head><h2 tabindex=-1 id=status-title>{{ card.title }}</h2></div>
    <section class="card status status--{{ card.kind }}" data-status={{ card.status }} aria-labelledby=status-title>
      {{ state_pill(kind, card.state_word) }}
      <p class=status__detail>{{ card.body|nw }}</p>
      {% if card.why %}<p class=status__detail data-why>{{ card.why }}</p>{% endif %}
      {% for b in card.buttons %}
        {% if b.get("action") == "connect" and b.kind == "link" %}
        <form method=post action=/client/calendar data-connect class=status__link>{{ csrf_input(csrf) }}<input type=hidden name=action value=connect><button type=submit class=linkbtn data-loading="{{ b.busy_label }}">{{ b.label }}</button></form>
        {% elif b.get("action") == "connect" %}
        <form method=post action=/client/calendar data-connect>{{ csrf_input(csrf) }}<input type=hidden name=action value=connect>{{ button(b.label, variant=b.kind, loading=b.busy_label) }}</form>
        {% elif b.get("href") %}
        <a class="btn btn--{{ b.kind }}" href="{{ b.href }}" data-support>{{ b.label }}</a>
        {% endif %}
      {% endfor %}
      {% if not ok and card.can_connect %}
      <details class=asks open>
        <summary class=asks__summary><span class=field__label>{{ consent_heading }}</span>{{ icon("chevron-down", "asks__chev") }}</summary>
        <ol class=steps-list>{% for step in consent_steps %}<li>{{ step }}</li>{% endfor %}</ol>
      </details>
      {% endif %}
    </section>
    {% if picker %}
    <details class=picker id=picker{% if picker_error %} open{% endif %}>
      <summary class="btn btn--secondary picker__summary">Use a different calendar</summary>
      <form method=post action=/client/calendar class="card choice-list" data-picker>
        {{ csrf_input(csrf) }}<input type=hidden name=action value=pick>
        <fieldset class=choice-list__set aria-describedby="picker-help{{ ' picker-error' if picker_error else '' }}">
          <legend class=choice-list__legend>{{ picker.legend }}</legend>
          <p class=field-help id=picker-help>{{ picker.hint }}</p>
          {% if picker_error %}{{ field_error("picker-error", picker_error) }}{% endif %}
          <div class=choice-list__items>
          {% for ch in picker.choices %}
            <label class=choice><input type=radio class=radio name=calendar_id value="{{ ch.id }}"{% if ch.in_use %} checked{% endif %}><span class=choice__text><span class=choice__name>{{ ch.name }}</span>{% if ch.main %}<span class=choice__meta>{{ picker.main_suffix }}</span>{% endif %}</span>{% if ch.in_use %}<span class="pill pill--success">{{ picker.pill }}</span>{% endif %}</label>
          {% endfor %}
          </div>
          {% if picker.only %}<p class=field-help>{{ picker.only }}</p>{% endif %}
        </fieldset>
        <div class=actions>{{ button(picker.button, variant="secondary", loading="Saving…", hook="data-picker-save") }}</div>
      </form>
    </details>
    {% elif picker_error %}<div class="notice notice--danger" role=alert>{{ icon("circle-alert", "notice__icon") }}<div class=notice__body><p class=notice__text>{{ picker_error }}</p></div></div>{% endif %}
  {% endcall %}
  {% call node("icon", "clock", attrs="id=availability") %}
    <div class=node__head><h2 tabindex=-1 id=avail-title>{{ availability.title }}</h2><p class=node__blurb>{{ availability.intro }}</p></div>
    <section class=card aria-labelledby=avail-title data-availability>
      {% if availability.starts %}
      <ul class=slots data-slots>{% for row in availability.rows %}<li class="slot tnum">{{ icon("calendar") }}<span>{{ row|nw }}</span></li>{% endfor %}</ul>
      {% endif %}
      {% if availability.empty %}<p class=empty__body>{{ availability.empty }}</p>{% endif %}
      {% if availability.error %}<p class=field-error>{{ icon("circle-alert") }}<span>{{ availability.error }}</span></p>{% endif %}
      {% if availability.caption %}<p class=field-help>{{ availability.caption|nw }}</p>{% endif %}
      {% if availability.note %}<p class=field-help data-any-time-note>{{ availability.note }}</p>{% endif %}
      {% if availability.button %}
      <form method=post action="/client/calendar#availability" class=actions data-check-form>{{ csrf_input(csrf) }}<input type=hidden name=action value=check>{{ button(availability.button, variant="secondary", loading=availability.busy_label) }}</form>
      {% elif availability.replaced %}<p class=field-help data-check-replaced>{{ availability.replaced }}</p>{% endif %}
    </section>
  {% endcall %}
</ol>
{% endblock %}
