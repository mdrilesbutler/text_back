{#- Primitives shared by every portal page. Imported macros do not see the page context: pass every value.
    Attribute quoting: closed-set single tokens unquoted, anything with spaces or owner/Google data double-quoted,
    CSRF always the literal name=csrf value='…' (tests parse exactly that). -#}

{% macro icon(name, cls="") -%}
<svg class="icon{{ (' ' ~ cls) if cls else '' }}" aria-hidden=true focusable=false><use href="#i-{{ name }}"/></svg>
{%- endmacro %}

{#- A node on the spine (mockup d1). State nodes draw the status: done (filled tick), needs (amber "!"),
    waiting (clock), todo (plain ring), manual (dashed ring, tick). Section nodes (kind="icon") only label a
    section with a decorative ring around `glyph`. `attrs` is a pre-rendered attribute string. -#}
{#- kind="missed" is a section node with the red missed-call dot (Messages' first step). -#}
{% macro node(kind, glyph="", attrs="", cls="") -%}
<li class="node node--{{ kind }}{{ (' ' ~ cls) if cls else '' }}"{% if attrs %} {{ attrs }}{% endif %}>
  <span class=node__dot aria-hidden=true>
    {%- if kind in ("icon", "missed") %}{{ icon(glyph) }}{% elif kind in ("done", "manual") %}{{ icon("check") }}{% elif kind == "waiting" %}{{ icon("clock") }}{% elif kind == "needs" %}<b class=node__bang>!</b>{% endif -%}
  </span>
  <div class=node__body>
    {{ caller() }}
  </div>
</li>
{%- endmacro %}

{#- The word beside a state node, in a pill with no glyph of its own (the node draws it). -#}
{% macro state_pill(kind, word) -%}
<span class="pill state state--{{ kind }}{{ ' pill--success' if kind == 'done' else (' pill--warning' if kind == 'needs' else '') }}">{{ word }}</span>
{%- endmacro %}

{#- The header as the save bar, at every width (mockup d1 round 3; desktop since the final-panel round 3): what changed (a disclosure listing links to each
    changed item), Discard and Save, both posting the page's form through form=. portal.js draws the same
    nodes for a form marked data-topsave. t: {"form", "changed", "save", "names": [(href, label)]}. -#}
{% macro topsave_bar(t) -%}
<div class=topsave data-topsave-server>
  <details class=topsave__changes>
    <summary class=topsave__summary><span class=topsave__count>{{ t.changed }}</span><span class=vh>. Show what changed</span>{{ icon("chevron-down", "topsave__chev") }}</summary>
    <ul class=topsave__list>{% for href, label in t.names %}<li><a href="{{ href }}">{{ label }}</a></li>{% endfor %}</ul>
  </details>
  <div class=topsave__actions>
    <button type=submit class="btn btn--ghost" name=discard value=1 form={{ t.form }} formnovalidate data-topsave-discard>Discard</button>
    <button type=submit class="btn btn--primary" form={{ t.form }}>{{ t.save }}</button>
  </div>
</div>
{%- endmacro %}

{#- The notice's close button, beside the role=status slot (never inside the live words). portal.js shows it
    while the slot holds a notice; without JavaScript it could do nothing, so it stays hidden. -#}
{% macro dismiss_button() -%}
<button type=button class="icon-btn toast__action notice-area__dismiss" data-notice-dismiss hidden>{{ icon("x") }}<span class=vh>Dismiss</span></button>
{%- endmacro %}

{% macro csrf_input(token) -%}
<input type=hidden name=csrf value='{{ token }}'>
{%- endmacro %}

{% macro button(label, variant="primary", type="submit", size="", block="", icon_name="", name="", value="", loading="", hook="", hidden=False, form="") -%}
<button type={{ type }} class="btn btn--{{ variant }}{{ (' btn--' ~ size) if size else '' }}{{ (' btn--' ~ block) if block else '' }}"{% if form %} form={{ form }}{% endif %}{% if name %} name={{ name }} value={{ value }}{% endif %}{% if loading %} data-loading="{{ loading }}"{% endif %}{% if hook %} {{ hook }}{% endif %}{% if hidden %} hidden{% endif %}>{% if icon_name %}{{ icon(icon_name) }}{% endif %}{{ label }}</button>
{%- endmacro %}

{% macro pill(variant, icon_name, word, hook="", hidden=False) -%}
<span class="pill pill--{{ variant }}"{% if hook %} {{ hook }}{% endif %}{% if hidden %} hidden{% endif %}>{{ icon(icon_name) }}{{ word }}</span>
{%- endmacro %}

{% macro notice(kind, text, title="", hook="") -%}
{% set icons = {"info": "info", "warning": "triangle-alert", "danger": "circle-alert", "success": "circle-check"} %}
<div class="notice notice--{{ kind }}" role={{ "alert" if kind == "danger" else "status" }}{% if hook %} {{ hook }}{% endif %}>
  {{ icon(icons[kind], "notice__icon") }}
  <div class=notice__body>{% if title %}<p class=notice__title>{{ title }}</p>{% endif %}<p class=notice__text>{{ text }}</p></div>
</div>
{%- endmacro %}

{% macro field_error(id, text) -%}
<p class=field-error id={{ id }}>{{ icon("circle-alert") }}<span>{{ text }}</span></p>
{%- endmacro %}

{% macro otp(id="code", error="", help_id="", value="", autofocus=True, idp="") -%}
{% set describedby = [help_id, (idp ~ id ~ "-error") if error else ""]|select|join(" ") %}
<div class=otp data-otp data-filled={{ value|length }}>
  <input id={{ idp }}{{ id }} name=code class=otp__input inputmode=numeric autocomplete=one-time-code pattern="[0-9]{6}" maxlength=6 required title="Six digits"{% if autofocus %} autofocus{% endif %} spellcheck=false autocapitalize=off autocorrect=off{% if value %} value="{{ value }}"{% endif %}{% if error %} aria-invalid=true{% endif %}{% if describedby %} aria-describedby="{{ describedby }}"{% endif %}>
  <span class=otp__cells aria-hidden=true><i></i><i></i><i></i><i></i><i></i><i></i></span>
</div>
{% if error %}{{ field_error(idp ~ id ~ "-error", error) }}{% endif %}
{%- endmacro %}

{#- bare=True: the toggle alone (in a card head); the label text stays for assistive tech. -#}
{% macro switch(field, label, on, saved_on, idp="", bare=False) -%}
<label class="switch-row{% if bare %} switch-row--bare{% endif %}" for={{ idp }}ask_{{ field }}><span class="{{ 'vh' if bare else 'switch-row__text' }}">{{ label }}</span><input type=checkbox role=switch class=switch id={{ idp }}ask_{{ field }} name=ask_{{ field }} value=1{% if on %} checked{% endif %} data-saved-checked={{ 1 if saved_on else 0 }}></label>
{%- endmacro %}

{#- Calendar status: pill, title, one sentence, the calendar in use when connected, then the next step
    (the caller: the Connect form when it is the primary action, or a note). -#}
{#- meta=False: a picker below names the calendar in use, so the meta line is left out; screen readers still
    hear the name before "this calendar" in the detail. -#}
{% macro status_block(s, idp="", meta=True) -%}
<section class=status data-status={{ s.kind }} aria-labelledby={{ idp }}status-title>
  {{ pill(s.pill_variant, s.pill_icon, s.pill_word) }}
  <h2 class=status__title id={{ idp }}status-title>{{ s.title }}</h2>
  {% if s.calendar and not meta %}<p class=vh>Google Calendar is connected and uses <strong>{{ s.calendar }}</strong>.</p>{% endif %}
  <p class=status__detail>{{ s.detail }}</p>
  {% if s.calendar and meta %}<dl class=status__meta><dt>Calendar</dt><dd><strong>{{ s.calendar }}</strong></dd></dl>{% endif %}
  {% if caller is defined %}<div class=status__next>{{ caller() }}</div>{% endif %}
</section>
{%- endmacro %}

{% macro stepper() -%}
<ol class=stepper aria-label="Change your mobile" data-stepper>
  <li class="stepper__step stepper__step--done"><span class=stepper__dot>{{ icon("check") }}</span><span class=stepper__label><span class=vh>Done: </span>Details saved</span></li>
  <li class="stepper__step stepper__step--current" aria-current=step><span class="stepper__dot tnum">2</span><span class=stepper__label>Confirm number</span></li>
</ol>
{%- endmacro %}

{#- jump: ((href, label), ...) drawn as a one-line row of link chips that scrolls inside itself. -#}
{% macro page_head(title, lead, meta="", jump=()) -%}
<header class=page-head>
  <h1>{{ title }}</h1>
  {% if lead %}<p class=lead>{{ lead }}</p>{% endif %}
  {% if meta %}<p class=page-head__meta>{{ icon("info") }}<span>{{ meta }}</span></p>{% endif %}
  {% if jump %}<nav class=jump aria-label="Jump to"><ul class=jump__list>{% for href, label in jump %}<li><a class=jump__link href={{ href }}>{{ label }}</a></li>{% endfor %}</ul></nav>{% endif %}
</header>
{%- endmacro %}

{% macro savebar(initial) -%}
<div class=savebar data-savebar data-state=nojs data-initial={{ initial }}>
  <p class="savebar__status tnum" data-savebar-status>Saves every message at once</p>
  <div class=savebar__actions>
    <button type=button class="btn btn--ghost" data-show-error hidden>Show</button>
    <button type=button class="btn btn--danger-ghost" data-discard hidden>Discard</button>
    <button type=submit class="btn btn--primary" name=save value=1 data-save data-loading="Saving…" aria-keyshortcuts="Control+S Meta+S">Save changes</button>
  </div>
</div>
{%- endmacro %}

{#- A TextBack bubble's text: URLs in span.sms__link (they may break anywhere), and the opt-out line added
    for the owner in span.sms__suffix. portal.js draws the same nodes. -#}
{% macro bubble_text(body, suffix="") -%}
{{ body|url_runs }}{% if suffix %} <span class=sms__suffix>{{ suffix }}</span>{% endif %}
{%- endmacro %}

{#- One row of a conversation: a bubble, a thread pill or the hand-off divider. tag="li" in the rail;
    badge=False drops the role badges (a card preview with only one speaker). -#}
{% macro thread_item(it, tag="div", hide=False, badge=True) -%}
{%- if it.kind == "customer" -%}
<{{ tag }} class="sms sms--customer"{% if it.ask %} data-ask={{ it.ask }}{% endif %}{% if hide %} hidden{% endif %}>{% if badge %}<span class=sms__badge>Customer</span>{% endif %}<p class=sms__bubble>{{ it.text }}</p></{{ tag }}>
{%- elif it.kind == "textback" -%}
<{{ tag }} class="sms sms--textback"{% if it.ask %} data-ask={{ it.ask }}{% endif %}{% if hide %} hidden{% endif %}>{% if badge %}<span class=sms__badge>TextBack</span>{% endif %}<p class=sms__bubble data-preview={{ it.key }}>{{ bubble_text(it.text, it.suffix) }}</p></{{ tag }}>
{%- elif it.kind == "handoff" -%}
<{{ tag }} class=handoff>{{ it.text }}</{{ tag }}>
{%- else -%}
<{{ tag }} class="tpill tpill--{{ it.kind }}">{% if it.icon %}{{ icon(it.icon) }}{% endif %}{{ it.text }}</{{ tag }}>
{%- endif -%}
{%- endmacro %}

{#- Sections at the top of a long page (round 4): a wrapped grid of 44px one-tap buttons (never a sideways row),
    then the compact "Jump to" bar. With JavaScript the bar is a 0-height sticky strip that shows only once the
    grid has scrolled away (it overlays, so the page never shifts); without it the bar sits in flow under the
    grid and sticks. portal.js names the section on screen ("Jump to: Booking") and marks it in both.
    sections: [(id, label)]; the page's html carries has-jump so scroll-padding counts the bar. -#}
{% macro stepnav(sections) -%}
<nav class=stepgrid aria-label="On this page" data-stepgrid><ul class=stepgrid__list>{% for sid, label in sections %}<li><a class=stepgrid__link href=#{{ sid }}>{{ label }}</a></li>{% endfor %}</ul></nav>
<div class=jumpbar data-jumpbar>
  <details class=jumpmenu data-jumpmenu>
    <summary class=jumpmenu__summary><span class=jumpmenu__label data-lead="Jump to:">Jump to a section</span>{{ icon("chevron-down", "jumpmenu__chev") }}</summary>
    <ul class=jumpmenu__list aria-label="On this page">{% for sid, label in sections %}<li><a class=jumpmenu__link href=#{{ sid }}{% if loop.first %} aria-current=location{% endif %}>{{ label }}</a></li>{% endfor %}</ul>
  </details>
</div>
{%- endmacro %}


{#- Coming up (round 4): the next bookings, soonest first (portal_status.upcoming). Home after "This week";
    Calendar under the connection card while connected. rows: [{label, service, name, location, example}]. -#}
{% macro upcoming_list(rows, empty) -%}
{% if rows %}
<ol class=upcoming data-upcoming>
{% for row in rows %}
  <li class=booking>
    <p class="booking__when tnum">{{ row.label|nw }}</p>
    <p class=booking__what><span class=booking__job>{{ row.service }}</span>{% if row.name %} · <span class=booking__name>{{ row.name }}</span>{% endif %}{% if row.example %} <span class=extag>Example</span>{% endif %}</p>
    {% if row.location %}<p class=booking__where>{{ row.location }}</p>{% endif %}
  </li>
{% endfor %}
</ol>
{% else %}
<div class=empty><p class=empty__body data-upcoming-empty>{{ empty }}</p></div>
{% endif %}
{%- endmacro %}
