# Local only. Never commit real secrets.
TEXT_BACK_WEBHOOK_SECRET=replace-me
TEXT_BACK_PUBLIC_BASE_URL=http://127.0.0.1:8000
TEXT_BACK_DB_PATH=./text_back.sqlite3
TEXT_BACK_BUSINESS_NAME=replace-me
# HELP-reply contact (website/email). Empty = the text number itself. Never the business line.
TEXT_BACK_BUSINESS_CONTACT=
# IANA timezone used to interpret customer-supplied local appointment times.
TEXT_BACK_TIMEZONE=UTC
# Positive whole minutes; travel buffers/working hours remain separate policy.
TEXT_BACK_APPOINTMENT_DURATION_MINUTES=60
# Operator queue label for durable handoff payloads.
TEXT_BACK_HANDOFF_DESTINATION=replace-me

# wiring_mode: how our number relates to the client's real phone line.
#   forwarded (default) - our number is NOT the client's public number.
#     The client keeps their existing number and sets up conditional call
#     forwarding (no-answer/busy) to our number. The carrier only ever
#     connects a call to us after the client's line already went unanswered,
#     so the first voice webhook we see for a call IS the missed call —
#     trigger the intro SMS on arrival, regardless of CallStatus.
#   managed - our number IS the client's public number (legacy/current
#     behavior). Only a terminal-unanswered CallStatus (no-answer/busy/
#     failed/canceled) represents a missed call.
TEXT_BACK_WIRING_MODE=forwarded

# Telecom provider. Keep "stub" for local tests. Set to "signalwire" only
# in a protected runtime environment after supplying all three values below.
TEXT_BACK_TELECOM_MODE=stub
TEXT_BACK_SIGNALWIRE_SPACE_URL=https://your-space.signalwire.com
TEXT_BACK_SIGNALWIRE_PROJECT_ID=replace-me
TEXT_BACK_SIGNALWIRE_API_TOKEN=replace-me
TEXT_BACK_SIGNALWIRE_FROM_NUMBER=+15551234567

# Persistent outboxes and the worker start with the application.
TEXT_BACK_CALENDAR_PROVIDER=google
TEXT_BACK_GOOGLE_CALENDAR_ID=replace-me
TEXT_BACK_GOOGLE_TOKEN_FILE=/path/to/protected/google_token.json
# Optional separate Web OAuth client JSON with registered /calendar/callback.
TEXT_BACK_GOOGLE_CLIENT_FILE=
# Independent random secret for operator HTTP access; never put it in a URL.
TEXT_BACK_OPERATOR_API_KEY=
# disabled parks alerts; log emits redacted notices. Arrange monitored delivery.
TEXT_BACK_HANDOFF_DELIVERY_CHANNEL=disabled
# For operator alerts in an existing private Telegram chat, select telegram.
TEXT_BACK_TELEGRAM_BOT_TOKEN=
TEXT_BACK_TELEGRAM_CHAT_ID=
TEXT_BACK_HANDOFF_DELIVERY_RETRY_MINUTES=1,5,15
TEXT_BACK_FOLLOWUP_DELAYS_MINUTES=120,1440
TEXT_BACK_FOLLOWUP_EXPIRY_MINUTES=2880
TEXT_BACK_QUIET_HOURS_START=21:00
TEXT_BACK_QUIET_HOURS_END=08:00
